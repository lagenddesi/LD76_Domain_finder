# LD76 Domain Finder Backend Configuration

# Application
APP_NAME=LD76 Domain Finder API
APP_ENV=development
APP_DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Security
API_SECRET_KEY=change-this-to-a-long-random-secret
ANDROID_API_KEY=change-this-to-a-random-client-key

# CORS
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./ld76_domain_finder.db

# Scanner
SCANNER_SCRIPT=scanner/scanner.py

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
